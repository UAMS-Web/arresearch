{
    "name": "uams-web/arresearch",
    "description": "A child theme for ARResearch.org, based on the Minimum Pro child theme.",
    "type": "wordpress-theme",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "pestphp/pest": "^5.3"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "pest"
    },
    "scripts-descriptions": {
        "test": "Run the test suites.",
        "test:unit": "Run the Pest suite that needs no WordPress and no database."
    }
}
